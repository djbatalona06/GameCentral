{
  "name": "meridian",
  "version": "0.1.0",
  "private": true,
  "description": "Meridian: an original mobile treasure-hunter action-adventure built with TypeScript and Babylon.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node tests/e2e/smoke.mjs",
    "assets": "node scripts/optimize-assets.mjs",
    "cap:sync": "npm run build && cap sync",
    "android:open": "cap open android",
    "ios:open": "cap open ios",
    "icons": "capacitor-assets generate --assetPath resources --iconBackgroundColor \"#0d1117\" --iconBackgroundColorDark \"#0d1117\" --splashBackgroundColor \"#0d1117\" --splashBackgroundColorDark \"#0d1117\" --android --ios"
  },
  "dependencies": {
    "@babylonjs/core": "^9.33.1",
    "@babylonjs/loaders": "^9.33.1",
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.0",
    "@gltf-transform/cli": "^4.5.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}

{
  "name": "meridian",
  "version": "0.1.0",
  "private": true,
  "description": "Meridian: an original mobile treasure-hunter action-adventure built with TypeScript and Babylon.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node tests/e2e/smoke.mjs",
    "assets": "node scripts/optimize-assets.mjs"
  },
  "dependencies": {
    "@babylonjs/core": "^9.33.1",
    "@babylonjs/loaders": "^9.33.1"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
